<odoo>
    <record id="view_delivery_carrier_form_dpd" model="ir.ui.view">
        <field name="name">delivery.carrier.form.dpd</field>
        <field name="model">delivery.carrier</field>
        <field name="inherit_id" ref="delivery.view_delivery_carrier_form" />
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="dpd" string="DPD" invisible="delivery_type != 'dpd'">
                    <group>
                        <group string="e-Station credentials">
                            <field name="dpd_login" />
                            <field name="dpd_password" password="True" />
                            <field name="dpd_customer_id" />
                            <field name="dpd_agency_id" />
                            <field name="dpd_test_mode" />
                        </group>
                        <group string="Pickup relay search">
                            <field name="dpd_pudo_key" password="True" />
                            <field name="dpd_pudo_carrier" />
                            <button
                                name="action_dpd_test_connection"
                                type="object"
                                string="Test connection"
                                icon="fa-plug"
                                class="btn-link"
                            />
                        </group>
                        <group string="Shipment">
                            <field name="dpd_product" />
                            <field
                                name="dpd_notifications"
                                invisible="dpd_product == 'DPD_Predict'"
                            />
                            <field name="dpd_label_format" />
                        </group>
                    </group>
                    <group string="Pricing">
                        <field name="dpd_pricing_method" />
                    </group>
                    <field
                        name="dpd_tariff_ids"
                        invisible="dpd_pricing_method != 'grid'"
                    >
                        <list editable="bottom">
                            <field name="zone" />
                            <field name="max_weight" />
                            <field name="price" />
                            <field name="currency_id" column_invisible="1" />
                        </list>
                    </field>
                    <field
                        name="price_rule_ids"
                        nolabel="1"
                        invisible="dpd_pricing_method != 'base_on_rule'"
                    />
                </page>
            </xpath>
        </field>
    </record>
</odoo>
