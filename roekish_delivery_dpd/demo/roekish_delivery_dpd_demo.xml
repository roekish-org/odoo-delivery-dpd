     rates are negotiated per contract: users copy these carriers and update
     the grids with their own contract rates. -->
<odoo>

    <!-- ===================== Products ===================== -->
    <record id="product_delivery_dpd_predict" model="product.product">
        <field name="name">DPD Predict</field>
        <field name="type">service</field>
        <field name="categ_id" ref="delivery.product_category_deliveries" />
        <field name="sale_ok" eval="False" />
        <field name="purchase_ok" eval="False" />
        <field name="list_price">0.0</field>
        <field name="invoice_policy">order</field>
    </record>
